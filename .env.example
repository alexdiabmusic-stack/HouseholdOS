# SERVER ONLY. Configure hosted values with Supabase secrets; never bundle in iOS.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=CA,US
PLAID_WEBHOOK_URL=
PLAID_REDIRECT_URI=
# Generate 32 random bytes encoded as 64 hex characters; retain for token decryption.
BANK_TOKEN_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_RETURN_URL=
ENABLE_LIVE_SERVICE_PAYMENTS=false
INSTACART_API_KEY=
# Explicitly choose development or production; development is the default.
INSTACART_ENV=development
APP_BUNDLE_ID=
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_ENVIRONMENT=sandbox
APP_STORE_APP_ID=
# DER Apple root certificates, base64 encoded and comma separated.
APPLE_ROOT_CA_BASE64=
PREMIUM_LAUNCH_ENABLED=false
